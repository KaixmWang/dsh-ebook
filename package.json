{
  "name": "dsh-ebook",
  "version": "0.5.3",
  "type": "module",
  "description": "给人和 AI 读的电子书库：多源搜书下载、扫描件 OCR、逐章翻译、封面与简介自动补齐、推送微信读书",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0",
    "@napi-rs/canvas": "^0.1.80",
    "pdfjs-dist": "^5.4.149",
    "qrcode": "^1.5.4",
    "undici": "^8.12.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KaixmWang/dsh-ebook.git"
  },
  "homepage": "https://github.com/KaixmWang/dsh-ebook#readme",
  "bugs": {
    "url": "https://github.com/KaixmWang/dsh-ebook/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "ebook",
    "epub",
    "pdf",
    "ocr",
    "translation",
    "opds",
    "library"
  ],
  "author": "KaixmWang",
  "license": "MIT"
}
